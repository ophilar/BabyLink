<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Zenith Hub v3 (Premium): Central Node with Radiating Flow -->
    
    <!-- Central Shimmer Node -->
    <path
        android:pathData="M54,54m-12,0a12,12 0,1 1,24 0a12,12 0,1 1,-24 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="12"
                android:type="radial">
                <item android:color="#FFFFFF" android:offset="0" />
                <item android:color="#B2EBF2" android:offset="0.7" />
                <item android:color="#00ACC1" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Radiating Connectivity Lines (Zenith Flow Style) -->
    <!-- Line 1 (Top Left) -->
    <path
        android:pathData="M54,42C54,42 45,30 30,30"
        android:strokeWidth="3"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="54"
                android:startY="42"
                android:endX="30"
                android:endY="30"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0" />
                <item android:color="#80DEEA" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    
    <!-- Line 2 (Top Right) -->
    <path
        android:pathData="M54,42C54,42 63,30 78,30"
        android:strokeWidth="3"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="54"
                android:startY="42"
                android:endX="78"
                android:endY="30"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0" />
                <item android:color="#80DEEA" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    
    <!-- Line 3 (Bottom) -->
    <path
        android:pathData="M54,66C54,66 54,85 54,95"
        android:strokeWidth="4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="54"
                android:startY="66"
                android:endX="54"
                android:endY="95"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0" />
                <item android:color="#4DD0E1" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
